page {
  background: #fff3d9;
}

.login-wrap {
  width: 100%;
  min-height: 100vh;
  background: #fff3d9;
  padding: 0 60rpx;
  box-sizing: border-box;
}

.header {
  margin-top: 110rpx;
  margin-bottom: 70rpx;
  text-align: center;
}
.title-main {
  font-size: 64rpx;
  color: #8c5d2b;
  font-weight: 600;
  letter-spacing: 6rpx;
  margin-bottom: 16rpx;
}
.title-sub {
  font-size: 30rpx;
  color: #b08a5a;
  letter-spacing: 2rpx;
}

.form-area {
  width: 100%;
  margin-bottom: 50rpx;
}
.form-item {
  margin-bottom: 36rpx;
}
.form-label {
  display: block;
  font-size: 30rpx;
  color: #8c5d2b;
  margin-bottom: 14rpx;
  padding-left: 10rpx;
}
.form-input {
  width: 100%;
  height: 100rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
  font-size: 32rpx;
  color: #5a3a1a;
  box-shadow: 0 4rpx 12rpx rgba(140, 93, 43, 0.06);
}
.input-ph {
  color: #c9b08a;
  font-size: 30rpx;
}

.btn-area {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap:28rpx;
}
.btn-primary {
  width: 100%;
  height: 100rpx;
  background: #f2a858;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 500;
  border-radius: 50rpx;
  border: none;
  letter-spacing: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}
.btn-primary::after {
  border: none;
}

.btn-wechat {
  width: 100%;
  height: 100rpx;
  background: #ffffff;
  color: #8c5d2b;
  font-size: 34rpx;
  font-weight: 500;
  border-radius: 50rpx;
  border: 2rpx solid #f2d0a0;
  letter-spacing: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}
.btn-wechat::after {
  border: none;
}

.register-tip {
  margin-top: 40rpx;
  text-align: center;
  font-size: 28rpx;
  color: #a07038;
}
.link-text {
  color: #e08a5a;
  margin-left: 8rpx;
}
/* 身份选择样式 */
.type-select{
  display:flex;
  gap:30rpx;
  margin-bottom:50rpx;
}
.radio-item{
  flex:1;
  display:flex;
  align-items:center;
  justify-content:center;
  background:#fff;
  padding:24rpx 10rpx;
  border-radius:20rpx;
  border:2rpx solid #f2d0a0;
  font-size:28rpx;
  color:#8c5d2b;
}
.radio-item.active{
  border-color:#f2a858;
  background:#fff8ee;
}
.radio-item radio{
  margin-right:12rpx;
}
