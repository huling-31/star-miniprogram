.index-wrap{
  width:100%;
  height:100vh;
  background:#fff3d9;
  display:flex;
  flex-direction:column;
  box-sizing:border-box;
  padding:20rpx;
}

/*顶部标题栏*/
.top-bar{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:16rpx 0;
}
.avatar-box{
  display:flex;
  align-items:center;
  gap:16rpx;
}
.avatar-img{
  width:72rpx;
  height:72rpx;
  border-radius:50%;
  background:#f2a85a;
  color:#fff;
  font-size:28rpx;
  display:flex;
  align-items:center;
  justify-content:center;
}
.name-title{
  font-size:30rpx;
  color:#5b3a1a;
  font-weight:bold;
}
.name-sub{
  font-size:22rpx;
  color:#8c5d2b;
}
.icon-btn{
  width:64rpx;
  height:64rpx;
  border-radius:50%;
  background:#ffe9c4;
  display:flex;
  align-items:center;
  justify-content:center;
}
.icon-font{
  font-size:28rpx;
}

/*中间聊天滚动容器*/
.chat-scroll {
  flex: 1;
  overflow: hidden;
  position: relative;
  padding: 20rpx 24rpx;
  background:#fff;
  border-radius:24rpx;
  box-sizing: border-box;
}

.chat-list {
  display: flex;
  flex-direction: column;
  will-change: transform;
}

.date-tip {
  text-align: center;
  font-size: 22rpx;
  color: #a07038;
  margin: 16rpx 0 24rpx;
}

.msg-row {
  display: flex;
  margin-bottom: 24rpx;
}
.ai-row {
  justify-content:flex-start;
}
.user-row {
  justify-content:flex-end;
}

.msg-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f2a85a;
  color: #fff;
  font-size:24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.msg-bubble {
  max-width: 70%;
  padding: 20rpx 24rpx;
  border-radius: 22rpx;
  font-size:26rpx;
  line-height: 1.7;
  word-break: break-word;
  position:relative;
}
/*AI气泡，左下角尖角*/
.ai-bubble {
  background: #fff8e8;
  color: #443322;
}
.ai-bubble::after{
  content:"";
  position:absolute;
  left:-12rpx;
  bottom:16rpx;
  border-width:12rpx;
  border-style:solid;
  border-color:transparent #fff8e8 transparent transparent;
}
/*用户气泡，右下角尖角，靠右对齐*/
.user-bubble {
  background: #f2a85a;
  color: #fff;
}
.user-bubble::after{
  content:"";
  position:absolute;
  right:-12rpx;
  bottom:16rpx;
  border-width:12rpx;
  border-style:solid;
  border-color:transparent transparent transparent #f2a85a;
}

/*输入栏*/
.input-bar{
  margin:16rpx 0;
}
.input-box{
  display:flex;
  align-items:center;
  background:#fff;
  border-radius:99rpx;
  padding:16rpx 20rpx;
}
.input-icon{
  font-size:26rpx;
  color:#8c5d2b;
  margin:0 10rpx;
}
.input-placeholder-text{
  color:#b89360;
  font-size:24rpx;
}

/*底部tab栏，统一按钮大小字体*/
.tab-bar{
  display:flex;
  gap:12rpx;
}
.tab-item{
  flex:1;
  text-align:center;
  padding:20rpx 8rpx;
  background:#ffe9c4;
  border-radius:99rpx;
  border:2rpx solid #f2d299;
}
.tab-label{
  font-size:24rpx;
  color:#5b3a1a;
}
