.wrap{
  width:100%;
  min-height:100vh;
  background:#fff3d9;
  padding:40rpx;
  box-sizing:border-box;
}
.title{
  font-size:44rpx;
  color:#8c5d2b;
  text-align:center;
  margin-bottom:12rpx;
}
.tip{
  font-size:26rpx;
  color:#a07038;
  text-align:center;
  margin-bottom:40rpx;
}
.record-box{
  margin-bottom:40rpx;
}
.record-item{
  background:#fff;
  border-radius:16rpx;
  padding:24rpx;
  margin-bottom:16rpx;
  font-size:28rpx;
  color:#664422;
}
.divider{
  width:100%;
  height:2rpx;
  background:#e6ccaa;
  margin:40rpx 0;
}
.sub-title{
  font-size:34rpx;
  color:#8c5d2b;
  margin-bottom:20rpx;
}
.textarea{
  width:100%;
  min-height:180rpx;
  background:#fff;
  border-radius:16rpx;
  padding:24rpx;
  font-size:28rpx;
  color:#332211;
  box-sizing:border-box;
}
.btn{
  width:100%;
  margin-top:30rpx;
  border-radius:99rpx;
  background:#f2a85a;
  color:#fff;
}
.back-btn{
  background:#e6ccaa;
  color:#443322;
}
.btn::after{
  border:none;
}
