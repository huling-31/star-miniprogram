.history-wrap{
  width:100%;
  min-height:100vh;
  background:#fff3d9;
  padding:60rpx 40rpx;
  box-sizing:border-box;
}
.history-title{
  font-size:48rpx;
  color:#8c5d2b;
  text-align:center;
  margin-bottom:40rpx;
  font-weight:500;
}
.list-scroll{
  width:100%;
  height:calc(100vh - 240rpx);
}
.item-card{
  background:#fff9e8;
  border-radius:20rpx;
  padding:32rpx;
  margin-bottom:24rpx;
  border:1rpx solid #f2ddbc;
}
.item-date{
  font-size:32rpx;
  color:#8c5d2b;
  margin-bottom:16rpx;
  font-weight:500;
}
.item-row{
  font-size:28rpx;
  color:#664422;
  line-height:1.6;
  margin-bottom:8rpx;
}
.empty-tip{
  text-align:center;
  font-size:28rpx;
  color:#a07038;
  margin-top:120rpx;
}
.btn-bottom{
  width:100%;
  position:fixed;
  bottom:60rpx;
  left:0;
  padding:0 40rpx;
  box-sizing:border-box;
}
.btn-back{
  width:100%;
  height:88rpx;
  line-height:88rpx;
  background:#ffe8c2;
  text-align:center;
  border-radius:44rpx;
  font-size:32rpx;
  color:#8c5d2b;
  border:1rpx solid #f2d0a0;
}
