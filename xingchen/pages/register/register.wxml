<view class="register-wrap">
  <!-- 顶部标题区 -->
  <view class="header">
    <view class="title-main">注册</view>
    <view class="title-sub">星辰，愿成为你心中的晨曦，点亮深夜的孤寂</view>
  </view>

  <!-- 表单区域 -->
  <view class="form-area">
    <view class="form-item">
      <text class="form-label">姓名</text>
      <input class="form-input" model:value="{{name}}" placeholder="请输入真实姓名" placeholder-class="input-ph" />
    </view>
    <view class="form-item">
      <text class="form-label">联系电话</text>
      <input class="form-input" type="number" maxlength="11" model:value="{{phone}}" placeholder="请输入11位手机号码" placeholder-class="input-ph" />
    </view>
    <view class="form-item">
      <text class="form-label">昵称</text>
      <input class="form-input" model:value="{{nickName}}" placeholder="设置你的昵称（用于登录）" placeholder-class="input-ph" />
    </view>
    <view class="form-item">
      <text class="form-label">密码</text>
      <input class="form-input" password model:value="{{pwd}}" placeholder="8位，包含数字+大小写英文字母" placeholder-class="input-ph" />
    </view>
    <view class="form-item">
      <text class="form-label">再次输入密码</text>
      <input class="form-input" password model:value="{{pwd2}}" placeholder="再次输入上面设置的密码" placeholder-class="input-ph" />
    </view>
    <view class="form-item">
      <text class="form-label">关联方姓名</text>
      <input class="form-input" model:value="{{relationName}}" placeholder="填写关心你的关联人姓名" placeholder-class="input-ph" />
    </view>
    <view class="form-item">
      <text class="form-label">关联方身份</text>
      <view class="radio-group">
        <label class="radio-item">
          <radio value="family" bindchange="radioChange" checked="{{relationType==='family'}}"/>
          <text>家人</text>
        </label>
        <label class="radio-item">
          <radio value="friend" bindchange="radioChange" checked="{{relationType==='friend'}}"/>
          <text>朋友</text>
        </label>
        <label class="radio-item">
          <radio value="teacher" bindchange="radioChange" checked="{{relationType==='teacher'}}"/>
          <text>老师</text>
        </label>
      </view>
    </view>
    <view class="form-item">
      <text class="form-label">关联方电话</text>
      <input class="form-input" type="number" maxlength="11" model:value="{{relationPhone}}" placeholder="关联人11位手机号码" placeholder-class="input-ph" />
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="btn-area">
    <button class="btn-submit" bindtap="onRegister">提交注册</button>
  </view>

  <!-- 底部跳转登录 -->
  <view class="login-tip">
    <text>已有账号？</text>
    <text class="link-text" bindtap="goLogin">前往登录</text>
  </view>
</view>
