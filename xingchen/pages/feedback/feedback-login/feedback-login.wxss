.login-container{
  width:100%;
  min-height:100vh;
  background-color:#fff3d9;
  padding:40rpx;
  box-sizing:border-box;
  display:flex;
  align-items:center;
  justify-content:center;
}
.card{
  width:100%;
  background:#fffaf0;
  border-radius:24rpx;
  padding:40rpx;
}
.card-title{
  font-size:36rpx;
  color:#8c5d2b;
  text-align:center;
  margin-bottom:12rpx;
}
.tip{
  font-size:24rpx;
  color:#a07038;
  text-align:center;
  margin-bottom:40rpx;
}
.form-item{
  margin-bottom:30rpx;
}
.label{
  font-size:28rpx;
  color:#704b26;
  margin-bottom:12rpx;
}
.input{
  width:100%;
  height:80rpx;
  background:#fff;
  border-radius:12rpx;
  padding:0 20rpx;
  font-size:28rpx;
  border:1rpx solid #e2d2bc;
}
.submit-btn{
  width:100%;
  background:#f2a85a;
  color:#fff;
  border-radius:50rpx;
  margin:20rpx 0;
}
.submit-btn::after{border:none;}
.back-btn{
  color:#b47b3c;
  background:transparent;
}
.back-btn::after{border:none;}
