.main-container{
  width:100%;
  min-height:100vh;
  background-color:#fff3d9;
  padding:40rpx;
  box-sizing:border-box;
}
.info-card,.chart-wrap,.record-card{
  background:#fffaf0;
  border-radius:24rpx;
  padding:30rpx;
  margin-bottom:30rpx;
}
.title,.chart-title,.card-title{
  font-size:32rpx;
  color:#8c5d2b;
  margin-bottom:20rpx;
}
.info-line{
  font-size:26rpx;
  color:#704b26;
  line-height:1.6;
}
.canvas{
  width:100%;
  height:300rpx;
}
.chart-desc{
  text-align:center;
  font-size:24rpx;
  color:#947247;
  margin-top:12rpx;
}
.textarea{
  width:100%;
  height:220rpx;
  background:#fff;
  border-radius:12rpx;
  padding:20rpx;
  font-size:26rpx;
  border:1rpx solid #e2d2bc;
}
.save-btn{
  width:100%;
  background:#f2a85a;
  color:#fff;
  border-radius:50rpx;
  margin-top:20rpx;
}
.save-btn::after{border:none;}
.back-btn{
  color:#b47b3c;
  background:transparent;
}
.back-btn::after{border:none;}
